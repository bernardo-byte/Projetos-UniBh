public class Main {
    public static void main(String[] args) {
        ContaBancaria c1 = new ContaBancaria(1001, "Ana Silva", 500.0);
        System.out.printf("Initial balance (c1): R$%.2f\n", c1.getSaldo());
        
        c1.depositar(150.0);
        System.out.printf("After R$150.00 deposit: R$%.2f\n", c1.getSaldo());
        
        boolean ok = c1.sacar(700.0);
        System.out.println("Attempt to withdraw R$700.00: " + (ok ? "success" : "failure"));
        System.out.printf("Final balance (c1): R$%.2f\n\n", c1.getSaldo());
        ContaBancaria c2 = new ContaBancaria(1002, "Carlos Oliveira", 1000.0);
        System.out.printf("Initial balance (c2): R$%.2f\n", c2.getSaldo());
        
        c2.depositar(300.0);
        System.out.printf("After R$300.00 deposit: R$%.2f\n", c2.getSaldo());
        
        ok = c2.sacar(200.0);
        System.out.println("Attempt to withdraw R$200.00: " + (ok ? "success" : "failure"));
        System.out.printf("Final balance (c2): R$%.2f\n", c2.getSaldo());
    }
}